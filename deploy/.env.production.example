# Place a filled copy outside the source checkout with mode 600.
# Generate five unrelated values with openssl rand -hex 32.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASS=
JWT_SECRET=

# Pin platform-compatible upstream and application images. Record image IDs.
MYSQL_IMAGE=
REDIS_IMAGE=
RABBITMQ_IMAGE=
API_IMAGE=
WORKER_IMAGE=
FRONTEND_IMAGE=

PREVIEW_PORT=15174
RELEASE_SUBNET=172.29.63.0/24
FRONTEND_PROXY_IP=172.29.63.2

# Can be explicitly false for a loopback smoke test without Alibaba Cloud.
OSS_DIRECT_UPLOAD=true
OSS_REGION=cn-guangzhou
OSS_BUCKET=
OSS_UPLOAD_ROLE_ARN=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_UPLOAD_ENDPOINT=
OSS_PLAYBACK_ENDPOINT=

# Public entry only. FEEDSYSTEM_PUBLIC_HOST is the site DNS name without a port.
FEEDSYSTEM_PUBLIC_HOST=
TLS_DIR=/etc/letsencrypt
