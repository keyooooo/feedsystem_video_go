server {
  listen 80 default_server;
  server_name _;
  server_tokens off;
  return 444;
}

server {
  listen 80;
  server_name ${FEEDSYSTEM_PUBLIC_HOST};
  server_tokens off;
  return 308 https://${FEEDSYSTEM_PUBLIC_HOST}$request_uri;
}

server {
  listen 443 ssl default_server;
  server_name _;
  ssl_reject_handshake on;
}

server {
  listen 443 ssl;
  server_name ${FEEDSYSTEM_PUBLIC_HOST};
  server_tokens off;
  ssl_certificate /etc/letsencrypt/live/${FEEDSYSTEM_PUBLIC_HOST}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${FEEDSYSTEM_PUBLIC_HOST}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 1m;
  include /etc/nginx/nginx-routes.conf;
}

server {
  listen 127.0.0.1:8081;
  access_log off;
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $api_origin http://backend:8080;
  location = /readyz {
    proxy_pass $api_origin;
  }
}
