{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:react": "vite --mode react",
    "build:react": "tsc -p tsconfig.react.json && vite build --mode react --outDir dist-react",
    "typecheck": "vue-tsc -b && tsc -p tsconfig.react.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "spark-md5": "^3.0.2",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0",
    "lucide-react": "^0.468.0",
    "@radix-ui/react-dialog": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vue-tsc": "^3.1.4",
    "vitest": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "jsdom": "^27.0.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
